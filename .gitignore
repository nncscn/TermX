# ============================================================
# TermX .gitignore
# 默认忽略一切，仅发布材料入仓
# ============================================================

# === 默认忽略根目录所有内容 ===
/*

# === 白名单：发布材料 ===
!README.md
!doc/
!.gitignore

# === doc/ 内排除脚本与临时文件 ===
doc/*.txt
doc/*.log
doc/*.tmp

# ============================================================
# 以下为本地工作目录与构建产物，不入仓
# ============================================================

# --- 源码与项目工程文件 ---
src/
electron/
native/
html/
installer/
resources/

# --- 配置文件 ---
main.js
*.config.js
*.config.ts
tsconfig*.json
tsconfig*.tsbuildinfo

# --- 辅助脚本 ---
*.py
gen-doc.ps1
verify_doc.py
verify_out.txt

# --- 构建产物 ---
dist/
out/
build/
*.exe
*.msi
*.appx
*.snap
*.deb
*.rpm
*.dmg

# --- 依赖 ---
node_modules/

# --- 日志 ---
*.log

# --- IDE 与编辑器配置 ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 操作系统垃圾 ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- 本地环境变量 / 密钥 ---
.env
.env.local
*.local
*.key
*.pem

# --- TypeScript / Rust 增量缓存 ---
*.tsbuildinfo
target/
